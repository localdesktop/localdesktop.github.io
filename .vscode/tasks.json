{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "[Android] Build",
      "command": "~/.cargo/bin/x",
      "args": [
        "build",
        "--release",
        "--platform=android",
        "--arch=arm64",
        "--format=apk"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "[Android] Build Debug",
      "command": "~/.cargo/bin/x",
      "args": ["build", "--platform=android", "--arch=arm64", "--format=apk"],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      // Everything the app's uid logs (Rust stdout/stderr, log:: output, proot and PipeWire children).
      "type": "shell",
      "label": "[Android] Logcat",
      "command": "sh",
      "args": [
        "-c",
        "PKG=$(awk '/^ *package:/ {print $2; exit}' manifest.yaml); UID_=$(adb shell pm list packages -U \"$PKG\" | sed -n \"s/^package:$PKG uid://p\" | tr -d '\\r'); adb logcat -c && adb logcat --uid=\"$UID_\""
      ],
      "problemMatcher": []
    }
  ]
}
